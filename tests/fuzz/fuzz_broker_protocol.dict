# libFuzzer dictionary for fuzz_broker_protocol (#2643): the protocol version and every message kind,
# as the little-endian u16s the frame header carries (src/Platform/BrokerProtocol.h).
version="\x05\x00"
kind_hello="\x01\x00"
kind_hello_reply="\x02\x00"
kind_signal="\x10\x00"
kind_set_priority="\x11\x00"
kind_set_io_priority="\x12\x00"
kind_set_affinity="\x13\x00"
kind_read_environment="\x20\x00"
kind_read_modules="\x21\x00"
kind_read_open_files="\x22\x00"
kind_read_connections="\x23\x00"
kind_read_memory_rollup="\x24\x00"
kind_read_firmware_file="\x25\x00"
kind_read_crashes="\x26\x00"
kind_action_result="\x30\x00"
kind_environment_result="\x31\x00"
kind_modules_result="\x32\x00"
kind_open_files_result="\x33\x00"
kind_connections_result="\x34\x00"
kind_memory_rollup_result="\x35\x00"
kind_firmware_file_result="\x36\x00"
kind_crashes_result="\x37\x00"
kind_read_process_counters="\x27\x00"
kind_process_counters_result="\x38\x00"
kind_error="\x3f\x00"
header_version_hello="\x04\x00\x01\x00"
header_version_read_modules="\x04\x00\x21\x00"
