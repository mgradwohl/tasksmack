BasedOnStyle: LLVM
Language: Cpp

# C++23 project (use Latest for newer clang-format compatibility)
Standard: Latest

IndentWidth: 4
TabWidth: 4
UseTab: Never

ColumnLimit: 140
ContinuationIndentWidth: 4

# Allman braces everywhere (Custom so BraceWrapping overrides are honoured)
BreakBeforeBraces: Custom

BraceWrapping:
  AfterCaseLabel:        true
  AfterClass:            true
  AfterControlStatement: Always
  AfterEnum:             true
  AfterExternBlock:      true
  AfterFunction:         true
  AfterNamespace:        true
  AfterStruct:           true
  AfterUnion:            true
  BeforeCatch:           true
  BeforeElse:            true
  BeforeLambdaBody:      true
  IndentBraces:          false
  SplitEmptyFunction:    false
  SplitEmptyRecord:      false
  SplitEmptyNamespace:   false

# Make spacing consistent & readable
SpacesInParens: Never
SpaceAfterCStyleCast: true
SpaceAfterTemplateKeyword: false
SpaceBeforeRangeBasedForLoopColon: true
SpaceBeforeInheritanceColon: true
SpaceBeforeCtorInitializerColon: true
SpaceBeforeAssignmentOperators: true

# Function calls: no space before, but control statements get one
SpaceBeforeParens: ControlStatements

# Pointer/reference style
PointerAlignment: Left
ReferenceAlignment: Left                  # `int& ref`

# Keep if/for/while blocks multi-line & readable
AllowShortIfStatementsOnASingleLine: Never
AllowShortFunctionsOnASingleLine: false
AllowShortBlocksOnASingleLine: false
AllowShortLambdasOnASingleLine: Inline

# Alignment / wrapping
AlignAfterOpenBracket: true
AlignConsecutiveAssignments: false
AlignConsecutiveDeclarations: false
AlignOperands: AlignAfterOperator
BinPackArguments: false
BinPackParameters: OnePerLine
BreakConstructorInitializers: BeforeColon
PackConstructorInitializers: NextLine

# Includes
SortIncludes: true
IncludeBlocks: Regroup

# Tell clang-format how to identify the "main" header (the TU's own .h/.hpp).
# Clang-format implicitly assigns it category 0 (sorted before all IncludeCategories
# entries below) when the header stem matches the source file stem (with any of the
# allowed suffixes, e.g. "_test", "_impl", "_win", "_linux").
IncludeIsMainRegex: '(_test|_impl|_win|_linux|_platform)?$'

IncludeCategories:
  # 1. All quoted local/project headers (.h/.hpp).
  #    The TU's own header (category 0) will already be sorted first by clang-format's
  #    built-in main-header detection above; remaining quoted .h/.hpp headers land here.
  - Regex: '^"([^"]+)\.(h|hpp)"$'
    Priority: 1

  # 2. Other quoted project headers (no extension, or non-.h/.hpp extension)
  - Regex: '^".*"'
    Priority: 2

  # 3. Third-party libraries (spdlog, imgui, implot, glad, SDL3, gtest, benchmark, etc.)
  - Regex: '^<(spdlog|fmt|boost|gtest|gmock|benchmark|imgui|implot|glad|SDL3)/.*>'
    Priority: 3

  # 4. Third-party single-header libs (imgui.h, implot.h without path)
  - Regex: '^<(imgui|implot|glad).*\.h>'
    Priority: 3

  # 5. C++ standard library headers (no extension)
  - Regex: '^<[a-z_]+>$'
    Priority: 4

  # 6. POSIX/C system headers (.h extension, including sys/ paths)
  - Regex: '^<.+\.h>$'
    Priority: 5

  # 7. Everything else (catch-all)
  - Regex: '.*'
    Priority: 6

SortUsingDeclarations: LexicographicNumeric

# Comments
ReflowComments: true
CommentPragmas: '^ NOLINT'
