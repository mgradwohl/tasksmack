    "workflowPresets": [
        {
            "name": "dev",
            "displayName": "Dev (configure \u2192 build \u2192 test)",
            "description": "Configure, build, and test the debug preset in one command: cmake --workflow --preset dev",
            "steps": [
                {
                    "type": "configure",
                    "name": "debug"
                },
                {
                    "type": "build",
                    "name": "debug"
                },
                {
                    "type": "test",
                    "name": "debug"
                }
            ]
        },
        {
            "name": "win-dev",
            "displayName": "Windows Dev (configure \u2192 build \u2192 test)",
            "description": "Configure, build, and test the Windows debug preset in one command.",
            "steps": [
                {
                    "type": "configure",
                    "name": "win-debug"
                },
                {
                    "type": "build",
                    "name": "win-debug"
                },
                {
                    "type": "test",
                    "name": "win-debug"
                }
            ]
        },
        {
            "name": "asan-ubsan-cycle",
            "displayName": "ASan+UBSan (configure → build → test)",
            "description": "Configure, build, and test the AddressSanitizer+UBSan preset.",
            "steps": [
                {
                    "type": "configure",
                    "name": "asan-ubsan"
                },
                {
                    "type": "build",
                    "name": "asan-ubsan"
                },
                {
                    "type": "test",
                    "name": "asan-ubsan"
                }
            ]
        },
        {
            "name": "tsan-cycle",
            "displayName": "TSan (configure → build → test)",
            "description": "Configure, build, and test the ThreadSanitizer preset.",
            "steps": [
                {
                    "type": "configure",
                    "name": "tsan"
                },
                {
                    "type": "build",
                    "name": "tsan"
                },
                {
                    "type": "test",
                    "name": "tsan"
                }
            ]
        },
