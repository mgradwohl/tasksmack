{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 29,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_STANDARD": "23",
                "CMAKE_CXX_STANDARD_REQUIRED": "ON",
                "CMAKE_CXX_EXTENSIONS": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "TASKSMACK_ENABLE_FETCHCONTENT_CACHE": "ON"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "clang++-22",
                "CMAKE_C_COMPILER": "clang-22",
                "CMAKE_CXX_FLAGS": "-stdlib=libc++ -pthread",
                "CMAKE_EXE_LINKER_FLAGS": "-stdlib=libc++ -pthread",
                "CMAKE_SHARED_LINKER_FLAGS": "-stdlib=libc++ -pthread"
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Linux"
                    ]
                }
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            },
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "$env{LLVM_ROOT}/bin/clang++.exe",
                "CMAKE_C_COMPILER": "$env{LLVM_ROOT}/bin/clang.exe",
                "CMAKE_LINKER_TYPE": "LLD",
                "CMAKE_EXE_LINKER_FLAGS": "",
                "CMAKE_SHARED_LINKER_FLAGS": ""
            },
            "vendor": {
                "microsoft.com/VisualStudioSettings/CMake/1.0": {
                    "hostOS": [
                        "Windows"
                    ]
                }
            }
        },
        {
            "name": "debug",
            "displayName": "Debug",
            "description": "Debug build with full debugging information",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -ftrivial-auto-var-init=pattern",
                "TASKSMACK_COPY_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "relwithdebinfo",
            "displayName": "RelWithDebInfo",
            "description": "Release build with debug information",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Optimized release build",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "optimized",
            "displayName": "Optimized",
            "description": "Fully optimized build with LTO, march=x86-64-v3, stripped (requires Haswell 2013+ CPUs)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "TASKSMACK_ENABLE_IPO": "ON",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-stdlib=libc++ -pthread -s",
                "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "-stdlib=libc++ -pthread -s",
                "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -fsplit-lto-unit",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -march=x86-64-v3 -fomit-frame-pointer -fwhole-program-vtables -fsplit-lto-unit"
            }
        },
        {
            "name": "release-compatible",
            "displayName": "Release (Compatible)",
            "description": "Release build compatible with older CPUs (x86-64-v2, 2009+)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -march=x86-64-v2"
            }
        },
        {
            "name": "coverage",
            "displayName": "Coverage",
            "description": "Debug build with code coverage instrumentation",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TASKSMACK_ENABLE_COVERAGE": "ON",
                "TASKSMACK_ENABLE_PCH": "OFF"
            }
        },
        {
            "name": "msan",
            "displayName": "MSan",
            "description": "MemorySanitizer: catches uninitialised-memory reads (Linux/Clang only). NOT CI-verified: no workflow exercises this preset. Requires an MSan-instrumented libc++ you build yourself and point CMAKE_PREFIX_PATH/link flags at - without one, this links against the ordinary libc++ and will report false positives from uninstrumented STL code.",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -fsanitize=memory -fPIE -fno-omit-frame-pointer -fsanitize-memory-track-origins=2",
                "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=memory -fPIE -pie",
                "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=memory",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
                "TASKSMACK_ENABLE_IPO": "OFF",
                "TASKSMACK_ENABLE_PCH": "OFF",
                "TASKSMACK_ENABLE_FETCHCONTENT_CACHE": "OFF"
            }
        },
        {
            "name": "unity",
            "displayName": "Unity (fast check build)",
            "description": "Debug build with unity (jumbo) compilation for fast end-to-end checks. Trades incremental correctness for speed.",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -ftrivial-auto-var-init=pattern",
                "CMAKE_UNITY_BUILD": "OFF",
                "TASKSMACK_ENABLE_UNITY_BUILD": "ON"
            }
        },
        {
            "name": "win-unity",
            "displayName": "Windows Unity (fast check build)",
            "description": "Windows debug build with unity (jumbo) compilation for fast end-to-end checks.",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/win-unity",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -ftrivial-auto-var-init=pattern",
                "CMAKE_UNITY_BUILD": "OFF",
                "TASKSMACK_ENABLE_UNITY_BUILD": "ON"
            }
        },
        {
            "name": "asan-ubsan",
            "displayName": "ASan+UBSan",
            "description": "Debug build with AddressSanitizer and UndefinedBehaviorSanitizer (Linux only)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -ftrivial-auto-var-init=pattern -fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined",
                "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=address,undefined",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
                "TASKSMACK_ENABLE_IPO": "OFF",
                "TASKSMACK_ENABLE_PCH": "OFF"
            }
        },
        {
            "name": "tsan",
            "displayName": "TSan",
            "description": "Debug build with ThreadSanitizer (Linux only, conflicts with ASan)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -ftrivial-auto-var-init=pattern -fsanitize=thread -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS_DEBUG": "-fsanitize=thread",
                "CMAKE_SHARED_LINKER_FLAGS_DEBUG": "-fsanitize=thread",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "OFF",
                "TASKSMACK_ENABLE_IPO": "OFF",
                "TASKSMACK_ENABLE_PCH": "OFF"
            }
        },
        {
            "name": "profile",
            "displayName": "Profile",
            "description": "Release build optimized for profiling with perf/Instruments (frame pointers preserved)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer",
                "TASKSMACK_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "benchmark",
            "displayName": "Benchmark",
            "description": "Release build for running benchmarks",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
                "TASKSMACK_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "pgo-generate",
            "displayName": "PGO Generate",
            "description": "Instrumented build to collect profiling data for PGO (run ./tools/pgo.sh generate, or ./tools/pgo.sh for the full workflow)",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG -fprofile-instr-generate",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-stdlib=libc++ -pthread -fprofile-instr-generate",
                "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "-stdlib=libc++ -pthread -fprofile-instr-generate",
                "TASKSMACK_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "pgo-use",
            "displayName": "PGO Use",
            "description": "PGO-optimized build using collected profile data from profiles/tasksmack.profdata (run tools/pgo.sh to generate). Requires x86-64-v3 capable CPU (Haswell/2013 or newer); will crash on older x86-64 hardware.",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -march=x86-64-v3 -fprofile-instr-use=\"${sourceDir}/profiles/tasksmack.profdata\" -Wno-profile-instr-unprofiled -Wno-profile-instr-out-of-date",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-stdlib=libc++ -pthread",
                "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "-stdlib=libc++ -pthread",
                "TASKSMACK_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "win-debug",
            "displayName": "Windows Debug",
            "description": "Debug build for Windows",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/win-debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_FLAGS_DEBUG": "-g -ftrivial-auto-var-init=pattern",
                "TASKSMACK_COPY_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "win-relwithdebinfo",
            "displayName": "Windows RelWithDebInfo",
            "description": "Release with debug info for Windows",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/win-relwithdebinfo",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "win-release",
            "displayName": "Windows Release",
            "description": "Release build for Windows",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/win-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "win-optimized",
            "displayName": "Windows Optimized",
            "description": "Fully optimized Windows build with LTO and march=x86-64-v3 (requires Haswell 2013+ CPUs)",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/win-optimized",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "TASKSMACK_ENABLE_IPO": "ON",
                "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
                "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG -fsplit-lto-unit",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -march=x86-64-v3 -fomit-frame-pointer -fwhole-program-vtables -fsplit-lto-unit"
            }
        },
        {
            "name": "win-release-compatible",
            "displayName": "Windows Release (Compatible)",
            "description": "Release build compatible with older CPUs (x86-64-v2, 2009+)",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/win-release-compatible",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -march=x86-64-v2"
            }
        },
        {
            "name": "win-coverage",
            "displayName": "Windows Coverage",
            "description": "Debug build with code coverage instrumentation",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/win-coverage",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TASKSMACK_ENABLE_COVERAGE": "ON",
                "TASKSMACK_ENABLE_PCH": "OFF"
            }
        },
        {
            "name": "win-profile",
            "displayName": "Windows Profile",
            "description": "Release build optimized for profiling with ETW/VTune (frame pointers preserved)",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/win-profile",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -DNDEBUG -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer",
                "TASKSMACK_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "win-benchmark",
            "displayName": "Windows Benchmark",
            "description": "Release build for running benchmarks",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/win-benchmark",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
                "TASKSMACK_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "win-pgo-generate",
            "displayName": "Windows PGO Generate",
            "description": "Instrumented build to collect profiling data for PGO on Windows (run pwsh tools/pgo.ps1 generate, or pwsh tools/pgo.ps1 for the full workflow)",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/win-pgo-generate",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG -fprofile-instr-generate",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-fprofile-instr-generate",
                "CMAKE_SHARED_LINKER_FLAGS_RELEASE": "-fprofile-instr-generate",
                "TASKSMACK_BUILD_BENCHMARKS": "ON"
            }
        },
        {
            "name": "win-pgo-use",
            "displayName": "Windows PGO Use",
            "description": "PGO-optimized Windows build using collected profile data from profiles/tasksmack.profdata (run tools/pgo.ps1 to generate). Requires x86-64-v3 capable CPU (Haswell/2013 or newer); will crash on older x86-64 hardware.",
            "inherits": "windows-base",
            "binaryDir": "${sourceDir}/build/win-pgo-use",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -march=x86-64-v3 -fprofile-instr-use=\"${sourceDir}/profiles/tasksmack.profdata\"",
                "TASKSMACK_BUILD_BENCHMARKS": "ON"
            }
        }
    ],
