# Writes a binary file into a C++ header as a constexpr byte array (cmake -P script). Used for the helper's
# eBPF object (#3366), which is a build output, so the embedding runs at build time, not configure time.
#
#   cmake -DINPUT=<file> -DOUTPUT=<header> -DNAME=<UPPER_SNAKE_NAME> -P EmbedBinary.cmake
foreach(var INPUT OUTPUT NAME)
    if(NOT DEFINED ${var})
        message(FATAL_ERROR "EmbedBinary.cmake: ${var} is required")
    endif()
endforeach()

file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hex_length)
math(EXPR byte_count "${hex_length} / 2")
if(byte_count EQUAL 0)
    message(FATAL_ERROR "EmbedBinary.cmake: ${INPUT} is empty")
endif()
# Sixteen bytes a line, each as 0xNN with a trailing comma.
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
string(REPEAT "0x[0-9a-f][0-9a-f]," 16 sixteen)
string(REGEX REPLACE "(${sixteen})" "\\1\n    " bytes "${bytes}")

get_filename_component(input_name "${INPUT}" NAME)
file(WRITE "${OUTPUT}.tmp"
    "// Generated by cmake/EmbedBinary.cmake from ${input_name}; do not edit.\n"
    "#pragma once\n\n"
    "#include <array>\n"
    "#include <cstddef>\n\n"
    "inline constexpr std::array<unsigned char, ${byte_count}> ${NAME}{\n"
    "    ${bytes}\n"
    "};\n")
# Only touch the header when the bytes change, so a rebuilt but identical object recompiles nothing.
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")
