--- a/include/toml++/impl/parser.inl
+++ b/include/toml++/impl/parser.inl
@@ -2294,9 +2294,12 @@ TOML_IMPL_NAMESPACE_START
 		{
 			return_if_error({});
 			assert_not_eof();
-			TOML_ASSERT_ASSUME(is_decimal_digit(*cp));
 			push_parse_scope("date"sv);
 
+			// the dispatch in parse_value() only gets here on a digit, but don't assume it (UB under NDEBUG)
+			if TOML_UNLIKELY(!is_decimal_digit(*cp))
+				set_error_and_return_default("expected 4-digit year, saw '"sv, to_sv(*cp), "'"sv);
+
 			// "YYYY"
 			uint32_t digits[4];
 			if (!consume_digit_sequence(digits, 4u))
@@ -2348,9 +2351,13 @@ TOML_IMPL_NAMESPACE_START
 		{
 			return_if_error({});
 			assert_not_eof();
-			TOML_ASSERT_ASSUME(is_decimal_digit(*cp));
 			push_parse_scope("time"sv);
 
+			// parse_date_time() calls this on whatever follows the 'T'/'t'/' ' separator, a non-digit in
+			// malformed input ('a=2000-02-10Tx:'): report it instead of assuming it can't happen (UB under NDEBUG)
+			if TOML_UNLIKELY(!is_decimal_digit(*cp))
+				set_error_and_return_default("expected 2-digit hour, saw '"sv, to_sv(*cp), "'"sv);
+
 			static constexpr size_t max_digits = 64; // far more than necessary but needed to allow fractional
 													 // millisecond truncation per the spec
 			uint32_t digits[max_digits];
@@ -2436,9 +2443,12 @@ TOML_IMPL_NAMESPACE_START
 		{
 			return_if_error({});
 			assert_not_eof();
-			TOML_ASSERT_ASSUME(is_decimal_digit(*cp));
 			push_parse_scope("date-time"sv);
 
+			// the dispatch in parse_value() only gets here on a digit, but don't assume it (UB under NDEBUG)
+			if TOML_UNLIKELY(!is_decimal_digit(*cp))
+				set_error_and_return_default("expected 4-digit year, saw '"sv, to_sv(*cp), "'"sv);
+
 			// "YYYY-MM-DD"
 			auto date = parse_date(true);
 			set_error_and_return_if_eof({});
@@ -2552,9 +2562,13 @@ TOML_IMPL_NAMESPACE_START
 		{
 			return_if_error({});
 			assert_not_eof();
-			TOML_ASSERT_ASSUME(!is_value_terminator(*cp));
 			push_parse_scope("value"sv);
 
+			// a value terminator here (e.g. the '}' in 'a=[}') is malformed input, not a broken precondition:
+			// report it instead of assuming it can't happen (TOML_ASSERT_ASSUME is UB under NDEBUG)
+			if TOML_UNLIKELY(is_value_terminator(*cp))
+				set_error_and_return_default("expected value, saw '"sv, to_sv(*cp), "'"sv);
+
 			const depth_counter_scope depth_counter{ nested_values };
 			if TOML_UNLIKELY(nested_values > max_nested_values)
 				set_error_and_return_default("exceeded maximum nested value depth of "sv,
@@ -2637,9 +2651,10 @@ TOML_IMPL_NAMESPACE_START
 				bool eof_while_scanning = false;
 				const auto scan			= [&]() noexcept(!TOML_COMPILER_HAS_EXCEPTIONS)
 				{
-					if (is_eof())
+					// the date-time rescan below can start on a terminator (the second ' ' in 'a=2000-02-01 1 1'):
+					// nothing to scan, so stop instead of assuming it can't happen (UB under NDEBUG)
+					if (is_eof() || is_value_terminator(*cp))
 						return;
-					TOML_ASSERT_ASSUME(!is_value_terminator(*cp));
 
 					do
 					{
