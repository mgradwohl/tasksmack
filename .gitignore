/.local/

# Backup/temp files
*~
*.bak
*.orig
*.swp
*.swo

# clangd cache
.clangd/

# Core dumps (anchored to repo root: an unanchored "core" pattern also matches the
# src/Core and tests/Core directories on case-insensitive filesystems, silently
# ignoring any new file added there)
/core
/core.*

# ImGui state file
imgui.ini

# Generated cast audit output
cast-audit.md
build.log
build-logs/
*.Zone.Identifier
build_output.txt

# Claude Code session-local runtime state (not project config)
.claude/scheduled_tasks.lock
