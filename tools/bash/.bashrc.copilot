# ==============================
# Copilot-safe shell
# ==============================

# Disable Oh My Posh entirely
export OMP_DISABLE=1
export OMP_TRANSIENT_PROMPT=0
export OMP_LINE_ERROR=0
export OMP_TOOLTIPS=0

# Minimal prompt (no ANSI tricks)
export PS1="\u@\h:\w\$ "

# Disable any prompt command hooks
unset PROMPT_COMMAND

# Disable terminal title changes
unset VTE_VERSION

# Make output deterministic
export TERM=xterm-256color
export CLICOLOR=0
export LS_COLORS=

# Avoid pagers
export LESS=-FRX

[[ "$TERM_PROGRAM" == "vscode" ]] && . "$(code --locate-shell-integration-path bash)"
