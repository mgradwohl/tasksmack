{
    // Terminal colors - ensure readable text
    "workbench.colorCustomizations": {
        "terminal.foreground": "#CCCCCC",
        "terminal.background": "#1E1E1E"
    },
    // Task/agent shells: no custom automation profiles. Custom args (e.g. --norc,
    // -NonInteractive) block VS Code's automatic shell-integration injection, which
    // removes the command start/end/exit-code markers (OSC 633) that Copilot Chat and
    // the task system rely on to detect command completion and read terminal output.
    // CMake Presets - VS Code CMake Tools will use CMakePresets.json
    "cmake.useCMakePresets": "always",
    "cmake.generator": "Ninja",
    "cmake.configureSettings": {
        "CMAKE_C_STANDARD": "17",
        "CMAKE_C_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
    },
    // Fully disable Microsoft C/C++ IntelliSense - we use clangd exclusively
    "C_Cpp.intelliSenseEngine": "disabled",
    "C_Cpp.autocomplete": "disabled",
    "C_Cpp.errorSquiggles": "disabled",
    "C_Cpp.formatting": "disabled",
    "C_Cpp.hover": "disabled",
    "C_Cpp.suggestSnippets": false,
    "C_Cpp.default.cppStandard": "c++23",
    "C_Cpp.default.cStandard": "c17",
    "C_Cpp.codeAnalysis.runAutomatically": false,
    "C_Cpp.codeAnalysis.clangTidy.enabled": false,
    "C_Cpp.codeAnalysis.exclude": {
        "**": true
    },
    "C_Cpp.files.exclude": {
        "**/build/**": true,
        "**/gladsources/**": true,
        "**/_deps/**": true
    },
    "C_Cpp.enhancedColorization": "disabled",
    "C_Cpp.dimInactiveRegions": false,
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--background-index",
        "--enable-config",
        "--clang-tidy",
        "--completion-style=detailed",
        "--header-insertion=iwyu",
        "--pch-storage=memory",
        "--query-driver=**/clang++,**/clang,**/g++,**/gcc,**/cl.exe"
    ],
    // Use PATH-resolved tool names so workspace settings are cross-platform.
    "clangd.path": "clangd",
    "clang-format.executable": "clang-format",
    "files.exclude": {
        "**/generated/**": true,
        "**/.cache/**": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/_deps/**": true,
        "**/.cache/**": true
    },
    "search.exclude": {
        "**/build/**": true,
        "**/_deps/**": true,
        "**/.cache/**": true
    },
    "editor.formatOnSave": true,
    "[cpp]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "[c]": {
        "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
    },
    "clangd.checkUpdates": true,
    "clangd.onConfigChanged": "restart",
    "C_Cpp.codeFolding": "disabled",
    "C_Cpp.configurationWarnings": "disabled",
    "C_Cpp.default.intelliSenseMode": "clang-x64",
    "C_Cpp.clang_format_sortIncludes": false,
    // Disable VS Code built-in markdown validator (too noisy on generated/third-party files)
    "markdown.validate.enabled": false,
    // Disable CMake Tools test discovery - use CTest preset tasks instead
    "cmake.ctest.testExplorerIntegrationEnabled": false,
    // Shell Integration: Enable advanced terminal features (command decorations, run recent, command history)
    "terminal.integrated.shellIntegration.enabled": true,
    // Preserve environment variables when launching terminals
    "terminal.integrated.inheritEnv": true,
    "terminal.integrated.shellIntegration.decorationsEnabled": "both",
    "terminal.integrated.shellIntegration.history": 100,
    // Larger scrollback so full build/test output stays readable by tools and agents.
    // (Persistent sessions and onExit revive are VS Code defaults; not restated here.)
    "terminal.integrated.scrollback": 10000
    // "cmake.cmakePath": "/snap/bin/cmake",
    // "cmake.cpackPath": "C:\\Program Files\\CMake\\bin\\cmake.exe",
    // "cmake.ctestPath": "/snap/bin/cmake"
}
