# IWYU mapping file for TaskSmack
# See: https://github.com/include-what-you-use/include-what-you-use/blob/master/docs/IWYUMappings.md

[
  # ImGui - treat imgui.h as the main include
  { include: ["<imgui_internal.h>", "private", "<imgui.h>", "public"] },

  # spdlog - allow fmt through spdlog
  { include: ["<fmt/core.h>", "private", "<spdlog/spdlog.h>", "public"] },
  { include: ["<fmt/format.h>", "private", "<spdlog/spdlog.h>", "public"] },

  # SDL3/GLAD - platform-specific handling
  { include: ["<GL/gl.h>", "private", "<glad/gl.h>", "public"] },

  # Note: C-to-C++ header mappings (e.g. <stdint.h> -> <cstdint>) are handled
  # by IWYU's built-in mappings in version 0.22+ and do not need to be listed
  # here. Defining them as "private" in this file conflicts with IWYU's internal
  # database (which marks them as "public"), causing assertion failures at
  # analysis time.

  # Project-specific: group related platform headers
  { include: ["\"Platform/Linux/LinuxProcessProbe.h\"", "private", "\"Platform/IProcessProbe.h\"", "public"] },
  { include: ["\"Platform/Windows/WindowsProcessProbe.h\"", "private", "\"Platform/IProcessProbe.h\"", "public"] },
  { include: ["\"Platform/Linux/LinuxDiskProbe.h\"", "private", "\"Platform/IDiskProbe.h\"", "public"] },
  { include: ["\"Platform/Windows/WindowsDiskProbe.h\"", "private", "\"Platform/IDiskProbe.h\"", "public"] },
  { include: ["\"Platform/Linux/LinuxGPUProbe.h\"", "private", "\"Platform/IGPUProbe.h\"", "public"] },
  { include: ["\"Platform/Windows/WindowsGPUProbe.h\"", "private", "\"Platform/IGPUProbe.h\"", "public"] },
  { include: ["\"Platform/Linux/LinuxSystemProbe.h\"", "private", "\"Platform/ISystemProbe.h\"", "public"] },
  { include: ["\"Platform/Windows/WindowsSystemProbe.h\"", "private", "\"Platform/ISystemProbe.h\"", "public"] },
  { include: ["\"Platform/Linux/LinuxPowerProbe.h\"", "private", "\"Platform/IPowerProbe.h\"", "public"] },
  { include: ["\"Platform/Windows/WindowsPowerProbe.h\"", "private", "\"Platform/IPowerProbe.h\"", "public"] },
  { include: ["\"Platform/Linux/LinuxPathProvider.h\"", "private", "\"Platform/IPathProvider.h\"", "public"] },
  { include: ["\"Platform/Windows/WindowsPathProvider.h\"", "private", "\"Platform/IPathProvider.h\"", "public"] },
  { include: ["\"Platform/Linux/LinuxProcessActions.h\"", "private", "\"Platform/IProcessActions.h\"", "public"] },
  { include: ["\"Platform/Windows/WindowsProcessActions.h\"", "private", "\"Platform/IProcessActions.h\"", "public"] }
]
