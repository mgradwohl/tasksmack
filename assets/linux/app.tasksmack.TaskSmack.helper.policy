<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  TaskSmack's privileged helper (#2307, #2181, #2448). TaskSmack starts it with pkexec when you choose to
  act on, or read the details of, a process you don't own, or to read root-only system facts. It acts on
  processes (ends, suspends or resumes them, or changes their priority, I/O priority or CPU affinity),
  reads other users' processes' environment, modules, open files, connections and PSS/USS, and reads the
  firmware's serial numbers, UUID and SMBIOS version, the memory modules and every user's crash reports.
  It answers only those requests, from the TaskSmack that started it, and exits when TaskSmack closes it
  or after a few idle minutes. auth_admin_keep: one password covers a few minutes of actions and reads.
-->
<policyconfig>
  <vendor>TaskSmack</vendor>
  <vendor_url>https://github.com/mgradwohl/tasksmack</vendor_url>
  <icon_name>app.tasksmack.TaskSmack</icon_name>
  <action id="app.tasksmack.TaskSmack.helper">
    <description>Act on and read processes you don't own, and read protected system information, in TaskSmack</description>
    <message>Authentication is required for TaskSmack to act on and read the details of other users' processes (including their environment variables) and to read protected system information</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/tasksmack/tasksmack-helper</annotate>
  </action>
</policyconfig>
