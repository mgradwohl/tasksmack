[Desktop Entry]
Version=1.0
Type=Application
Name=TaskSmack (Administrator)
GenericName=System Monitor
Comment=TaskSmack with administrator rights: every process and every action
TryExec=pkexec
Exec=pkexec /usr/bin/TaskSmack
Icon=app.tasksmack.TaskSmack
Terminal=false
Categories=System;Monitor;
Keywords=system;monitor;task;manager;cpu;memory;process;administrator;root;
StartupNotify=true
StartupWMClass=TaskSmack
