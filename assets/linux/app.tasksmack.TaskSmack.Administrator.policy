<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  TaskSmack started as administrator (#3580): the "TaskSmack (Administrator)" launcher runs
  pkexec /usr/bin/TaskSmack, and this action lets pkexec start it with the display (allow_gui keeps
  DISPLAY and XAUTHORITY). On Linux a TaskSmack session is administrator for its whole life or not at
  all: it never asks for a password after it starts. auth_admin: a password each launch.
-->
<policyconfig>
  <vendor>TaskSmack</vendor>
  <vendor_url>https://github.com/mgradwohl/tasksmack</vendor_url>
  <icon_name>app.tasksmack.TaskSmack</icon_name>
  <action id="app.tasksmack.TaskSmack.administrator">
    <description>Start TaskSmack as administrator</description>
    <message>Authentication is required to start TaskSmack as administrator, so it can see and act on every process and read protected system information</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/TaskSmack</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
